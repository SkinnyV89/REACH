# Copy to .env and fill in real values. Never commit .env.

# Neon PostgreSQL connection string (use the pooled URL with sslmode=require)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require"

# Random secret of at least 32 characters, e.g. `openssl rand -base64 32`
BETTER_AUTH_SECRET=""

# Public base URL of the app (no trailing slash)
BETTER_AUTH_URL="http://localhost:3000"

# Claude API key for campaign generation (server-side only, never NEXT_PUBLIC_).
# Leave empty in development to use clearly labelled template copy instead.
ANTHROPIC_API_KEY=""

# Optional: override the model (default claude-opus-5-5).
# AI_MODEL=""
