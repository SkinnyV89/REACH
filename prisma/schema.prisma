generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

// Permissions only. Whether someone sells is decided by having an active
// Seller profile, not by their role: every account can buy, and selling is
// something an account adds.
enum UserRole {
  ADMIN
  SELLER // legacy: no longer assigned; existing users were moved to MEMBER
  MEMBER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  role          UserRole @default(MEMBER)
  name          String   @default("")
  image         String?
  emailVerified Boolean  @default(false) @map("email_verified")
  // The town a buyer browses near (chosen, or snapped from "Use my location").
  // Only the town is kept, never coordinates.
  placeId       String?  @map("place_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  seller        Seller?
  auditLogs     AuditLog[]
  aiJobs        AIJob[]
  follows       Follow[]
  notifications Notification[]
  place         Place?         @relation(fields: [placeId], references: [id], onDelete: SetNull)

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Used by Better Auth to persist rate-limit counters, so limits hold across
// serverless instances instead of resetting per process.
model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// CATEGORIES (configurable; seeded by migration, managed as data not code)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sellers         SellerCategory[]
  products        Product[]
  masterCampaigns MasterCampaign[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// PLACES (GeoNames, CC BY 4.0 — https://www.geonames.org). Towns and cities
// with approximate centre points. Never a seller's address.
// ---------------------------------------------------------------------------

model Place {
  id         String   @id @default(uuid())
  geonameId  Int      @unique @map("geoname_id")
  slug       String   @unique
  name       String
  province   Province
  latitude   Float
  longitude  Float
  population Int      @default(0)
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")

  sellers Seller[]
  users   User[]

  @@index([province, name])
  @@map("places")
}

// ---------------------------------------------------------------------------
// SELLER PROFILE (Replaces SkinBuy Distributor/Brand)
// ---------------------------------------------------------------------------

enum SellerStatus {
  ONBOARDING // profile started, wizard not finished
  ACTIVE // onboarding complete
}

enum FulfilmentOption {
  DELIVERY
  COLLECTION
  ONLINE // service or product delivered digitally / remotely
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTH_WEST
  NORTHERN_CAPE
  WESTERN_CAPE
}

enum StorefrontLayout {
  PORTFOLIO // services: hair, beauty, barbers
  PRODUCT_GRID // goods
  MENU // food and baking
}

model Seller {
  id             String             @id @default(uuid())
  userId         String             @unique @map("user_id")
  // Public address of the seller's page. Generated once at creation and kept
  // stable so shared links never break when the business name is edited.
  slug           String             @unique
  status         SellerStatus       @default(ONBOARDING)
  businessName   String             @map("business_name")
  description    String?
  whatsappNumber String?            @map("whatsapp_number") // E.164, e.g. +27821234567
  province       Province?
  location       String? // town, suburb or area
  fulfilment     FulfilmentOption[] @default([])
  serviceArea    String?            @map("service_area") // delivery coverage in the seller's words
  logoUrl        String?            @map("logo_url") // unused: superseded by logoMediaId, dropped in a later cleanup
  websiteUrl     String?            @map("website_url")
  instagramUrl   String?            @map("instagram_url")
  facebookUrl    String?            @map("facebook_url")
  tiktokUrl      String?            @map("tiktok_url")
  onboardedAt    DateTime?          @map("onboarded_at")

  // Storefront (/s/<slug>). Unpublished until the seller opts in.
  placeId               String?          @map("place_id")
  areaDetail            String?          @map("area_detail") // neighbourhood in the seller's words, e.g. "Pimville"
  serviceRadiusKm       Int?             @map("service_radius_km") // how far they deliver / travel
  tagline               String?
  layout                StorefrontLayout @default(PRODUCT_GRID)
  storefrontPublishedAt DateTime?        @map("storefront_published_at")
  logoMediaId           String?          @unique @map("logo_media_id")
  coverMediaId          String?          @unique @map("cover_media_id")

  // Collection point. A precise pin set by the seller standing at their shop
  // ("Use my location here"); used for distances and directions. The street
  // address is shown only when the seller turns on collection, and only to
  // signed-in buyers.
  pinLatitude       Float?    @map("pin_latitude")
  pinLongitude      Float?    @map("pin_longitude")
  offersCollection  Boolean   @default(false) @map("offers_collection")
  collectionAddress String?   @map("collection_address")
  // A second number for phone calls (E.164); WhatsApp stays whatsappNumber.
  callNumber        String?   @map("call_number")
  // "Closed today": closed until this moment (end of the day it was set).
  closedUntil       DateTime? @map("closed_until")
  // Short note shown with the hours, e.g. "Taking orders for tomorrow".
  hoursNote         String?   @map("hours_note")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  place                Place?                @relation(fields: [placeId], references: [id], onDelete: SetNull)
  logo                 Media?                @relation("SellerLogo", fields: [logoMediaId], references: [id], onDelete: SetNull)
  cover                Media?                @relation("SellerCover", fields: [coverMediaId], references: [id], onDelete: SetNull)
  media                Media[]               @relation("SellerMedia")
  posts                Post[]
  hours                SellerHours[]
  followers            Follow[]
  notificationsAbout   Notification[]
  productSlugRedirects ProductSlugRedirect[]
  categories           SellerCategory[]
  products             Product[]
  sellerCampaigns      SellerCampaign[]
  leads                Lead[]
  attributionEvents    AttributionEvent[]

  @@index([storefrontPublishedAt])
  // Explore search: trigram indexes (pg_trgm) tolerate typos and work across
  // languages, unlike English word-stemming.
  @@index([businessName(ops: raw("gin_trgm_ops"))], type: Gin, map: "sellers_business_name_trgm_idx")
  @@index([tagline(ops: raw("gin_trgm_ops"))], type: Gin, map: "sellers_tagline_trgm_idx")
  @@map("sellers")
}

// Weekly opening hours. Several slots per day are allowed; a slot that
// closes before it opens runs past midnight. Times are minutes after
// midnight, South African time.
model SellerHours {
  id        String @id @default(uuid())
  sellerId  String @map("seller_id")
  dayOfWeek Int    @map("day_of_week") // 0 = Sunday … 6 = Saturday
  opensAt   Int    @map("opens_at")
  closesAt  Int    @map("closes_at")

  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@index([sellerId, dayOfWeek])
  @@map("seller_hours")
}

model SellerCategory {
  sellerId   String   @map("seller_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([sellerId, categoryId])
  @@index([categoryId])
  @@map("seller_categories")
}

// ---------------------------------------------------------------------------
// PRODUCT CATALOGUE
// ---------------------------------------------------------------------------

enum ProductKind {
  PRODUCT
  SERVICE
}

enum PriceType {
  FIXED // "R250"
  FROM // "From R250" — common for services and made-to-order items
  ON_REQUEST // "Price on request"; price is null
}

// What the buyer can expect. Seller-set, shown with when it was last updated.
enum Availability {
  IN_STOCK
  PRE_ORDER
  MADE_TO_ORDER
  OUT_OF_STOCK
  BY_BOOKING // services
}

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE // temporarily out of stock / not taking bookings
  ARCHIVED // hidden from the seller's list and from campaigns
}

model Product {
  id                    String        @id @default(uuid())
  sellerId              String        @map("seller_id")
  categoryId            String        @map("category_id")
  kind                  ProductKind   @default(PRODUCT)
  name                  String
  description           String?
  // Unused: superseded by the product_media table, dropped in a later cleanup.
  media                 Json          @default("[]")
  priceType             PriceType     @default(FIXED) @map("price_type")
  price                 Decimal?      @db.Decimal(10, 2)
  currency              String        @default("ZAR")
  // Lifecycle: AVAILABLE/UNAVAILABLE mirror availability for older code;
  // ARCHIVED hides the item everywhere.
  status                ProductStatus @default(AVAILABLE)
  // Readable public address within the storefront: /s/<seller>/<slug>.
  slug                  String
  availability          Availability  @default(IN_STOCK)
  availabilityUpdatedAt DateTime      @default(now()) @map("availability_updated_at")
  leadTimeDays          Int?          @map("lead_time_days") // pre-order / made to order
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  seller            Seller                @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category          Category              @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sellerCampaigns   SellerCampaign[]
  leads             Lead[]
  attributionEvents AttributionEvent[]
  slugRedirects     ProductSlugRedirect[]
  photos            ProductMedia[]
  taggedIn          PostProduct[]

  @@unique([sellerId, slug])
  @@index([sellerId, status])
  @@index([categoryId])
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, map: "products_name_trgm_idx")
  @@map("products")
}

// Old product slugs keep working after a rename: /s/<seller>/<old-slug>
// permanently redirects to the product's current slug.
model ProductSlugRedirect {
  sellerId  String   @map("seller_id")
  slug      String
  productId String   @map("product_id")
  createdAt DateTime @default(now()) @map("created_at")

  seller  Seller  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([sellerId, slug])
  @@index([productId])
  @@map("product_slug_redirects")
}

// ---------------------------------------------------------------------------
// MEDIA (photos). Files live in object storage (Vercel Blob); these rows hold
// their public URLs. Every image is re-encoded on the server first, which
// strips GPS, camera and other metadata.
// ---------------------------------------------------------------------------

enum MediaKind {
  LOGO
  COVER
  PRODUCT
  POST
}

// Only images can be uploaded today. VIDEO is reserved for short clips in
// Proof Posts (Step 2): url will hold the video and thumbUrl its poster
// image. Logos and covers are always images (checked by the database).
enum MediaType {
  IMAGE
  VIDEO
}

// How a photo reached REACH. Set by the server, never taken from the browser.
// Every upload today comes from the seller's files (GALLERY). IN_APP_CAMERA is
// reserved for REACH's own in-page camera, which isn't built yet; only that
// flow may set it, so "Taken in REACH" can't be claimed for a gallery photo.
enum CaptureSource {
  GALLERY
  IN_APP_CAMERA
}

model Media {
  id              String        @id @default(uuid())
  sellerId        String        @map("seller_id")
  kind            MediaKind
  mediaType       MediaType     @default(IMAGE) @map("media_type")
  captureSource   CaptureSource @default(GALLERY) @map("capture_source")
  capturedAt      DateTime?     @map("captured_at") // only for IN_APP_CAMERA
  // Storage keys of every stored size, so all of them can be deleted.
  storageKeys     String[]      @map("storage_keys")
  url             String // large size
  thumbUrl        String        @map("thumb_url") // small size (same as url for logos)
  width           Int // of the large size
  height          Int
  bytes           Int // all sizes together
  altText         String?       @map("alt_text") // seller's description, read by screen readers
  // When the seller confirmed they have permission from anyone shown.
  peopleConsentAt DateTime?     @map("people_consent_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  seller       Seller        @relation("SellerMedia", fields: [sellerId], references: [id], onDelete: Cascade)
  logoOf       Seller?       @relation("SellerLogo")
  coverOf      Seller?       @relation("SellerCover")
  productPhoto ProductMedia?
  postPhoto    PostMedia?

  @@index([sellerId, kind])
  @@map("media")
}

// A product's photos, in order. Position 0 is the main photo. The database
// allows positions 0-5 only, so an item can never hold more than six.
model ProductMedia {
  productId String @map("product_id")
  mediaId   String @unique @map("media_id")
  position  Int

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([productId, mediaId])
  @@unique([productId, position])
  @@map("product_media")
}

// ---------------------------------------------------------------------------
// PROOF POSTS: a seller's photos of their work, shown on their storefront.
// ---------------------------------------------------------------------------

enum PostStatus {
  DRAFT // created, photos still being added; never public
  PUBLISHED
  HIDDEN // hidden by the seller; can be shown again
  REMOVED // removed by REACH (moderation); the seller can't re-publish it
}

model Post {
  id          String     @id @default(uuid())
  sellerId    String     @map("seller_id")
  // Short random code for the public URL /s/<seller>/posts/<code>, so
  // internal ids never appear in public pages.
  code        String     @unique
  caption     String
  status      PostStatus @default(DRAFT)
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  seller        Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  media         PostMedia[]
  products      PostProduct[]
  leads         Lead[]
  events        AttributionEvent[]
  notifications Notification[]

  @@index([sellerId, status, publishedAt])
  // Feed: newest published posts first, with the public code as the
  // tie-breaker (so feed cursors never contain internal ids).
  @@index([status, publishedAt(sort: Desc), code(sort: Desc)])
  @@map("posts")
}

// A post's photos (and, later, video clips), in order. The database allows
// positions 0-5 only, so a post can never hold more than six.
model PostMedia {
  postId   String @map("post_id")
  mediaId  String @unique @map("media_id")
  position Int

  post  Post  @relation(fields: [postId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Cascade)

  @@id([postId, mediaId])
  @@unique([postId, position])
  @@map("post_media")
}

// Items tagged in a post (the seller's own; up to five).
model PostProduct {
  postId    String @map("post_id")
  productId String @map("product_id")

  post    Post    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([postId, productId])
  @@index([productId])
  @@map("post_products")
}

// ---------------------------------------------------------------------------
// FOLLOWING & NOTIFICATIONS
// ---------------------------------------------------------------------------

// A user following a seller. Private: sellers see how many follow them, never
// who. Buyers see and manage their own list.
model Follow {
  userId    String   @map("user_id")
  sellerId  String   @map("seller_id")
  createdAt DateTime @default(now()) @map("created_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@id([userId, sellerId])
  @@index([sellerId, createdAt])
  @@map("follows")
}

enum NotificationType {
  NEW_POST // a followed seller published a post (grouped while unread)
}

// In-app notifications. NEW_POST notifications are grouped: while one from a
// seller is unread, a new post updates it (count + 1, latest post) instead of
// adding another. Email delivery can be added later as a separate table.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  sellerId  String           @map("seller_id")
  postId    String?          @map("post_id") // the latest post it's about
  // Every post this notification has counted, so a post is never counted twice.
  postIds   String[]         @default([]) @map("post_ids")
  count     Int              @default(1)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @default(now()) @map("updated_at")
  readAt    DateTime?        @map("read_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  seller Seller @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  post   Post?  @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt(sort: Desc)])
  @@index([postId])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// CAMPAIGN ENGINE (Master vs Seller Personalisation)
// ---------------------------------------------------------------------------

// The reusable template created by REACH AI
enum CampaignSource {
  AI // written by the configured AI model
  TEMPLATE // built-in fallback copy, used when no AI provider is configured
}

enum MasterCampaignStatus {
  PUBLISHED // visible to sellers in the category
  ARCHIVED // hidden from sellers; existing seller campaigns keep their copy
}

// The reusable campaign template for one category. Copy contains the
// placeholders {{business_name}} and optionally {{location}}, which are filled
// from each seller's verified profile when they personalise it.
model MasterCampaign {
  id           String               @id @default(uuid())
  categoryId   String               @map("category_id")
  title        String
  objective    String
  headline     String
  body         String
  callToAction String               @map("call_to_action")
  assets       Json                 @default("[]") // future images/video concepts
  source       CampaignSource
  model        String? // AI model id when source = AI
  status       MasterCampaignStatus @default(PUBLISHED)
  aiJobId      String?              @unique @map("ai_job_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  aiJob           AIJob?           @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  sellerCampaigns SellerCampaign[]

  @@index([categoryId, status])
  @@map("master_campaigns")
}

// The personalised version created by the Seller
// Where a campaign's share link sends people. New campaigns go to the
// storefront with ?c=<code>; older ones keep their /c/<link> page.
enum CampaignDestination {
  CAMPAIGN_PAGE
  STOREFRONT
}

enum SellerCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
}

// A seller's own copy of a master campaign. The personalised text is a
// snapshot: later edits to the master never change it.
model SellerCampaign {
  id               String               @id @default(uuid())
  masterCampaignId String               @map("master_campaign_id")
  sellerId         String               @map("seller_id")
  productId        String?              @map("product_id")
  // Public share path segment, "<seller-slug>-<random code>", e.g.
  // "thandis-hair-boutique-k7Qm2xPa". Random, so links can't be guessed.
  uniqueLink       String               @unique @map("unique_link")
  headline         String
  body             String
  callToAction     String               @map("call_to_action")
  status           SellerCampaignStatus @default(DRAFT)
  destination      CampaignDestination  @default(CAMPAIGN_PAGE)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  masterCampaign    MasterCampaign     @relation(fields: [masterCampaignId], references: [id], onDelete: Restrict)
  seller            Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  leads             Lead[]
  attributionEvents AttributionEvent[]

  @@unique([sellerId, masterCampaignId])
  @@index([sellerId, status])
  @@map("seller_campaigns")
}

// ---------------------------------------------------------------------------
// LEADS & ATTRIBUTION
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// Where a visitor came from, from the ?src= parameter on a share link.
// UNKNOWN means no (recognised) parameter: never guessed.
enum LeadChannel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  UNKNOWN
  REACH // REACH's own discovery: Explore and the feed (?src=reach)
}

enum LeadSource {
  CAMPAIGN_PAGE // enquiry form on /c/<link>
  STOREFRONT // enquiry form on /s/<seller>
  PRODUCT // enquiry form on /s/<seller>/<item>
  POST // enquiry form on /s/<seller>/posts/<code>
}

model Lead {
  id               String      @id @default(uuid())
  sellerId         String      @map("seller_id")
  sellerCampaignId String?     @map("seller_campaign_id")
  productId        String?     @map("product_id")
  postId           String?     @map("post_id")
  name             String
  contact          String // phone number, E.164
  message          String?
  status           LeadStatus  @default(NEW)
  source           LeadSource
  channel          LeadChannel @default(UNKNOWN)
  // Raw ?src= value as received (sanitised), kept as evidence for attribution.
  utmSource        String?     @map("utm_source")
  // When the customer ticked the consent box (POPIA).
  consentAt        DateTime    @map("consent_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerCampaign SellerCampaign? @relation(fields: [sellerCampaignId], references: [id], onDelete: SetNull)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  post           Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([sellerId, status, createdAt])
  @@index([sellerId, contact, createdAt])
  @@index([sellerCampaignId, contact, createdAt])
  @@map("leads")
}

enum EventTarget {
  CAMPAIGN // /c/<link>
  STOREFRONT // /s/<seller>
  PRODUCT // /s/<seller>/<item>
  POST // /s/<seller>/posts/<code>
}

enum AttributionEventType {
  VIEW // campaign page opened
  WHATSAPP_CLICK // "Chat on WhatsApp" tapped
}

// Anonymous engagement events. sessionId is a random first-party cookie
// value; no personal data is stored here.
model AttributionEvent {
  id               String               @id @default(uuid())
  sessionId        String               @map("session_id")
  sellerId         String               @map("seller_id")
  sellerCampaignId String?              @map("seller_campaign_id")
  eventType        AttributionEventType @map("event_type")
  target           EventTarget          @default(CAMPAIGN)
  productId        String?              @map("product_id")
  postId           String?              @map("post_id")
  channel          LeadChannel          @default(UNKNOWN)
  occurredAt       DateTime             @default(now()) @map("occurred_at")

  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerCampaign SellerCampaign? @relation(fields: [sellerCampaignId], references: [id], onDelete: SetNull)
  product        Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  post           Post?           @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([sellerId, target, eventType, occurredAt])
  @@index([sellerCampaignId, eventType, occurredAt])
  @@map("attribution_events")
}

// Fixed-window counters for public endpoints (lead form). Keys contain a
// hashed IP, never the raw address.
model PublicRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")

  @@map("public_rate_limits")
}

// ---------------------------------------------------------------------------
// AI & AUDIT
// ---------------------------------------------------------------------------

enum AIJobType {
  CAMPAIGN_GENERATION
  MENU_IMPORT // reading items and prices from a seller's flyer photo
}

enum AIJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// One record per AI request, so cost and failures are visible.
model AIJob {
  id           String      @id @default(uuid())
  taskType     AIJobType   @map("task_type")
  status       AIJobStatus @default(RUNNING)
  requestedBy  String      @map("requested_by")
  provider     String // "anthropic" or "template"
  model        String?
  attempts     Int         @default(0)
  inputTokens  Int?        @map("input_tokens")
  outputTokens Int?        @map("output_tokens")
  // Failure reason for operators. Never contains prompts or personal data.
  error        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  finishedAt   DateTime?   @map("finished_at")

  requester      User            @relation(fields: [requestedBy], references: [id])
  masterCampaign MasterCampaign?

  @@index([createdAt])
  @@map("ai_jobs")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
