generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
// passed to PrismaClient through the pg adapter at runtime (src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SELLER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  role          UserRole @default(SELLER)
  name          String   @default("")
  image         String?
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  seller    Seller?
  auditLogs AuditLog[]
  aiJobs    AIJob[]

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Used by Better Auth to persist rate-limit counters, so limits hold across
// serverless instances instead of resetting per process.
model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// CATEGORIES (configurable; seeded by migration, managed as data not code)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sellers         SellerCategory[]
  products        Product[]
  masterCampaigns MasterCampaign[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// SELLER PROFILE (Replaces SkinBuy Distributor/Brand)
// ---------------------------------------------------------------------------

enum SellerStatus {
  ONBOARDING // profile started, wizard not finished
  ACTIVE // onboarding complete
}

enum FulfilmentOption {
  DELIVERY
  COLLECTION
  ONLINE // service or product delivered digitally / remotely
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTH_WEST
  NORTHERN_CAPE
  WESTERN_CAPE
}

model Seller {
  id             String             @id @default(uuid())
  userId         String             @unique @map("user_id")
  // Public address of the seller's page. Generated once at creation and kept
  // stable so shared links never break when the business name is edited.
  slug           String             @unique
  status         SellerStatus       @default(ONBOARDING)
  businessName   String             @map("business_name")
  description    String?
  whatsappNumber String?            @map("whatsapp_number") // E.164, e.g. +27821234567
  province       Province?
  location       String? // town, suburb or area
  fulfilment     FulfilmentOption[] @default([])
  serviceArea    String?            @map("service_area") // delivery coverage in the seller's words
  logoUrl        String?            @map("logo_url") // set once file storage is configured
  websiteUrl     String?            @map("website_url")
  instagramUrl   String?            @map("instagram_url")
  facebookUrl    String?            @map("facebook_url")
  tiktokUrl      String?            @map("tiktok_url")
  onboardedAt    DateTime?          @map("onboarded_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories        SellerCategory[]
  products          Product[]
  sellerCampaigns   SellerCampaign[]
  leads             Lead[]
  attributionEvents AttributionEvent[]

  @@map("sellers")
}

model SellerCategory {
  sellerId   String   @map("seller_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([sellerId, categoryId])
  @@index([categoryId])
  @@map("seller_categories")
}

// ---------------------------------------------------------------------------
// PRODUCT CATALOGUE
// ---------------------------------------------------------------------------

enum ProductKind {
  PRODUCT
  SERVICE
}

enum PriceType {
  FIXED // "R250"
  FROM // "From R250" — common for services and made-to-order items
  ON_REQUEST // "Price on request"; price is null
}

enum ProductStatus {
  AVAILABLE
  UNAVAILABLE // temporarily out of stock / not taking bookings
  ARCHIVED // hidden from the seller's list and from campaigns
}

model Product {
  id          String        @id @default(uuid())
  sellerId    String        @map("seller_id")
  categoryId  String        @map("category_id")
  kind        ProductKind   @default(PRODUCT)
  name        String
  description String?
  // Image references. Stays empty until file storage is configured.
  media       Json          @default("[]")
  priceType   PriceType     @default(FIXED) @map("price_type")
  price       Decimal?      @db.Decimal(10, 2)
  currency    String        @default("ZAR")
  status      ProductStatus @default(AVAILABLE)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  seller          Seller           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  sellerCampaigns SellerCampaign[]

  @@index([sellerId, status])
  @@index([categoryId])
  @@map("products")
}

// ---------------------------------------------------------------------------
// CAMPAIGN ENGINE (Master vs Seller Personalisation)
// ---------------------------------------------------------------------------

// The reusable template created by REACH AI
enum CampaignSource {
  AI // written by the configured AI model
  TEMPLATE // built-in fallback copy, used when no AI provider is configured
}

enum MasterCampaignStatus {
  PUBLISHED // visible to sellers in the category
  ARCHIVED // hidden from sellers; existing seller campaigns keep their copy
}

// The reusable campaign template for one category. Copy contains the
// placeholders {{business_name}} and optionally {{location}}, which are filled
// from each seller's verified profile when they personalise it.
model MasterCampaign {
  id           String               @id @default(uuid())
  categoryId   String               @map("category_id")
  title        String
  objective    String
  headline     String
  body         String
  callToAction String               @map("call_to_action")
  assets       Json                 @default("[]") // future images/video concepts
  source       CampaignSource
  model        String? // AI model id when source = AI
  status       MasterCampaignStatus @default(PUBLISHED)
  aiJobId      String?              @unique @map("ai_job_id")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  category        Category         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  aiJob           AIJob?           @relation(fields: [aiJobId], references: [id], onDelete: SetNull)
  sellerCampaigns SellerCampaign[]

  @@index([categoryId, status])
  @@map("master_campaigns")
}

// The personalised version created by the Seller
enum SellerCampaignStatus {
  DRAFT
  ACTIVE
  PAUSED
}

// A seller's own copy of a master campaign. The personalised text is a
// snapshot: later edits to the master never change it.
model SellerCampaign {
  id               String               @id @default(uuid())
  masterCampaignId String               @map("master_campaign_id")
  sellerId         String               @map("seller_id")
  productId        String?              @map("product_id")
  // Public share path segment, "<seller-slug>-<random code>", e.g.
  // "thandis-hair-boutique-k7Qm2xPa". Random, so links can't be guessed.
  uniqueLink       String               @unique @map("unique_link")
  headline         String
  body             String
  callToAction     String               @map("call_to_action")
  status           SellerCampaignStatus @default(DRAFT)
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")

  masterCampaign    MasterCampaign     @relation(fields: [masterCampaignId], references: [id], onDelete: Restrict)
  seller            Seller             @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  product           Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  leads             Lead[]
  attributionEvents AttributionEvent[]

  @@unique([sellerId, masterCampaignId])
  @@index([sellerId, status])
  @@map("seller_campaigns")
}

// ---------------------------------------------------------------------------
// LEADS & ATTRIBUTION
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

// Where a visitor came from, from the ?src= parameter on a share link.
// UNKNOWN means no (recognised) parameter: never guessed.
enum LeadChannel {
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  TIKTOK
  UNKNOWN
}

enum LeadSource {
  CAMPAIGN_PAGE // enquiry form on /c/<link>
}

model Lead {
  id               String      @id @default(uuid())
  sellerId         String      @map("seller_id")
  sellerCampaignId String?     @map("seller_campaign_id")
  name             String
  contact          String // phone number, E.164
  message          String?
  status           LeadStatus  @default(NEW)
  source           LeadSource
  channel          LeadChannel @default(UNKNOWN)
  // Raw ?src= value as received (sanitised), kept as evidence for attribution.
  utmSource        String?     @map("utm_source")
  // When the customer ticked the consent box (POPIA).
  consentAt        DateTime    @map("consent_at")
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerCampaign SellerCampaign? @relation(fields: [sellerCampaignId], references: [id], onDelete: SetNull)

  @@index([sellerId, status, createdAt])
  @@index([sellerCampaignId, contact, createdAt])
  @@map("leads")
}

enum AttributionEventType {
  VIEW // campaign page opened
  WHATSAPP_CLICK // "Chat on WhatsApp" tapped
}

// Anonymous engagement events. sessionId is a random first-party cookie
// value; no personal data is stored here.
model AttributionEvent {
  id               String               @id @default(uuid())
  sessionId        String               @map("session_id")
  sellerId         String               @map("seller_id")
  sellerCampaignId String?              @map("seller_campaign_id")
  eventType        AttributionEventType @map("event_type")
  channel          LeadChannel          @default(UNKNOWN)
  occurredAt       DateTime             @default(now()) @map("occurred_at")

  seller         Seller          @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sellerCampaign SellerCampaign? @relation(fields: [sellerCampaignId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([sellerCampaignId, eventType, occurredAt])
  @@map("attribution_events")
}

// Fixed-window counters for public endpoints (lead form). Keys contain a
// hashed IP, never the raw address.
model PublicRateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")

  @@map("public_rate_limits")
}

// ---------------------------------------------------------------------------
// AI & AUDIT
// ---------------------------------------------------------------------------

enum AIJobType {
  CAMPAIGN_GENERATION
}

enum AIJobStatus {
  RUNNING
  SUCCEEDED
  FAILED
}

// One record per AI request, so cost and failures are visible.
model AIJob {
  id           String      @id @default(uuid())
  taskType     AIJobType   @map("task_type")
  status       AIJobStatus @default(RUNNING)
  requestedBy  String      @map("requested_by")
  provider     String // "anthropic" or "template"
  model        String?
  attempts     Int         @default(0)
  inputTokens  Int?        @map("input_tokens")
  outputTokens Int?        @map("output_tokens")
  // Failure reason for operators. Never contains prompts or personal data.
  error        String?
  createdAt    DateTime    @default(now()) @map("created_at")
  finishedAt   DateTime?   @map("finished_at")

  requester      User            @relation(fields: [requestedBy], references: [id])
  masterCampaign MasterCampaign?

  @@index([createdAt])
  @@map("ai_jobs")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
