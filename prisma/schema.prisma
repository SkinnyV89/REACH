generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// Prisma 7: the connection URL lives in prisma.config.ts (for Migrate) and is
// passed to PrismaClient through the pg adapter at runtime (src/lib/db.ts).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// IDENTITY & ACCESS
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  SELLER
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  role          UserRole @default(SELLER)
  name          String   @default("")
  image         String?
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  seller    Seller?
  auditLogs AuditLog[]
  aiJobs    AIJob[]

  sessions Session[]
  accounts Account[]

  @@map("users")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Account {
  id                    String    @id @default(uuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("accounts")
}

// Used by Better Auth to persist rate-limit counters, so limits hold across
// serverless instances instead of resetting per process.
model RateLimit {
  id          String @id @default(uuid())
  key         String @unique
  count       Int
  lastRequest BigInt @map("last_request")

  @@map("rate_limits")
}

model Verification {
  id         String   @id @default(uuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verifications")
}

// ---------------------------------------------------------------------------
// CATEGORIES (configurable; seeded by migration, managed as data not code)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(uuid())
  slug        String   @unique
  name        String
  description String?
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  sellers SellerCategory[]

  @@map("categories")
}

// ---------------------------------------------------------------------------
// SELLER PROFILE (Replaces SkinBuy Distributor/Brand)
// ---------------------------------------------------------------------------

enum SellerStatus {
  ONBOARDING // profile started, wizard not finished
  ACTIVE // onboarding complete
}

enum FulfilmentOption {
  DELIVERY
  COLLECTION
  ONLINE // service or product delivered digitally / remotely
}

enum Province {
  EASTERN_CAPE
  FREE_STATE
  GAUTENG
  KWAZULU_NATAL
  LIMPOPO
  MPUMALANGA
  NORTH_WEST
  NORTHERN_CAPE
  WESTERN_CAPE
}

model Seller {
  id             String             @id @default(uuid())
  userId         String             @unique @map("user_id")
  // Public address of the seller's page. Generated once at creation and kept
  // stable so shared links never break when the business name is edited.
  slug           String             @unique
  status         SellerStatus       @default(ONBOARDING)
  businessName   String             @map("business_name")
  description    String?
  whatsappNumber String?            @map("whatsapp_number") // E.164, e.g. +27821234567
  province       Province?
  location       String? // town, suburb or area
  fulfilment     FulfilmentOption[] @default([])
  serviceArea    String?            @map("service_area") // delivery coverage in the seller's words
  logoUrl        String?            @map("logo_url") // set once file storage is configured
  websiteUrl     String?            @map("website_url")
  instagramUrl   String?            @map("instagram_url")
  facebookUrl    String?            @map("facebook_url")
  tiktokUrl      String?            @map("tiktok_url")
  onboardedAt    DateTime?          @map("onboarded_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  categories        SellerCategory[]
  products          Product[]
  sellerCampaigns   SellerCampaign[]
  leads             Lead[]
  attributionEvents AttributionEvent[]

  @@map("sellers")
}

model SellerCategory {
  sellerId   String   @map("seller_id")
  categoryId String   @map("category_id")
  createdAt  DateTime @default(now()) @map("created_at")

  seller   Seller   @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@id([sellerId, categoryId])
  @@index([categoryId])
  @@map("seller_categories")
}

// ---------------------------------------------------------------------------
// PRODUCT CATALOGUE
// ---------------------------------------------------------------------------

model Product {
  id          String   @id @default(uuid())
  sellerId    String   @map("seller_id")
  name        String
  category    String
  description String?
  media       Json     @default("[]")
  price       Decimal? @db.Decimal(10, 2)
  status      String   @default("active") // active | archived
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  seller Seller @relation(fields: [sellerId], references: [id])

  @@map("products")
}

// ---------------------------------------------------------------------------
// CAMPAIGN ENGINE (Master vs Seller Personalisation)
// ---------------------------------------------------------------------------

// The reusable template created by REACH AI
model MasterCampaign {
  id        String   @id @default(uuid())
  category  String
  title     String
  objective String
  baseCopy  String   @map("base_copy")
  assets    Json     @default("[]") // AI generated images/video concepts
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  sellerCampaigns SellerCampaign[]

  @@map("master_campaigns")
}

// The personalised version created by the Seller
model SellerCampaign {
  id               String   @id @default(uuid())
  masterCampaignId String   @map("master_campaign_id")
  sellerId         String   @map("seller_id")
  productId        String?  @map("product_id")
  uniqueLink       String   @unique @map("unique_link")
  customCopy       String   @map("custom_copy")
  status           String   @default("draft") // draft | active | paused
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  masterCampaign    MasterCampaign     @relation(fields: [masterCampaignId], references: [id])
  seller            Seller             @relation(fields: [sellerId], references: [id])
  leads             Lead[]
  attributionEvents AttributionEvent[]

  @@map("seller_campaigns")
}

// ---------------------------------------------------------------------------
// LEADS & ATTRIBUTION
// ---------------------------------------------------------------------------

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  LOST
}

model Lead {
  id               String     @id @default(uuid())
  sellerId         String     @map("seller_id")
  sellerCampaignId String?    @map("seller_campaign_id")
  name             String?
  contact          String // Phone or email
  message          String?
  status           LeadStatus @default(NEW)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  seller         Seller          @relation(fields: [sellerId], references: [id])
  sellerCampaign SellerCampaign? @relation(fields: [sellerCampaignId], references: [id])

  @@map("leads")
}

model AttributionEvent {
  id               String   @id @default(uuid())
  sessionId        String   @map("session_id")
  sellerId         String   @map("seller_id")
  sellerCampaignId String?  @map("seller_campaign_id")
  eventType        String   @map("event_type") // VIEW | CLICK | WHATSAPP_CLICK
  occurredAt       DateTime @default(now()) @map("occurred_at")

  seller         Seller          @relation(fields: [sellerId], references: [id])
  sellerCampaign SellerCampaign? @relation(fields: [sellerCampaignId], references: [id])

  @@index([sessionId])
  @@map("attribution_events")
}

// ---------------------------------------------------------------------------
// AI & AUDIT
// ---------------------------------------------------------------------------

model AIJob {
  id          String   @id @default(uuid())
  taskType    String   @map("task_type") // CAMPAIGN_GENERATION | IMAGE_GENERATION
  status      String   @default("pending") // pending | completed | failed
  requestedBy String   @map("requested_by")
  tokensUsed  Int?     @map("tokens_used")
  createdAt   DateTime @default(now()) @map("created_at")

  requester User @relation(fields: [requestedBy], references: [id])

  @@map("ai_jobs")
}

model AuditLog {
  id        String   @id @default(uuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  createdAt DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}
